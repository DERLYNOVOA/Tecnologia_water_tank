package application.service;

import domain.model.TemperatureSensor;
import domain.service.RepositoryLog;

/**
 * Gestor de temperatura.
 * ✅ Implementa contrato de SensorLevelManager.
 * LSP: Es una instancia válida de "manejador de sensores".
 */
public class TemperatureManager extends SensorLevelManager {
    private TemperatureSensor temperatureSensor;

    public TemperatureManager(
            TemperatureSensor temperatureSensor, 
            float minLevel, 
            float maxLevel,
            RepositoryLog logger) {  // ✅ AGREGADO
        super(minLevel, maxLevel, logger);  // ✅ PASA A PADRE
        this.temperatureSensor = temperatureSensor;
    }

    /**
     * Lógica específica de gestión de temperatura.
     * ✅ IMPLEMENTA el contrato abstracto.
     */
    @Override
    public void run() {
        if (!isActive) return;

        float tempActual = temperatureSensor.getTemperature();

        // Lógica de gestión de temperatura
        if (tempActual > maxLevel) {
            logger.saveLog("[ALERTA] Temperatura alta: " + tempActual + "°C");
            // Podría disparar acciones: encender ventilador, etc.
        } else if (tempActual < minLevel) {
            logger.saveLog("[ALERTA] Temperatura baja: " + tempActual + "°C");
            // Podría disparar acciones: encender calentador, etc.
        }
    }

    public void setTemperature(float temperature) {
        temperatureSensor.setTemperature(temperature);
    }

    public TemperatureSensor getTemperatureSensor() {
        return temperatureSensor;
    }
}
```

