package application.service;

import domain.service.RepositoryLog;

/**
 * Clase abstracta base para gestión de sensores.
 * ✅ ABSTRACT: Define contrato claro que todo hijo DEBE implementar.
 * LSP cumplido: todo hijo es instancia válida de "manejador de sensores".
 */
public abstract class SensorLevelManager {
    protected float level;
    protected float minLevel;
    protected float maxLevel;
    protected boolean isActive;
    protected RepositoryLog logger;  // ✅ AGREGADO para logging

    public SensorLevelManager(float minLevel, float maxLevel, RepositoryLog logger) {
        this.minLevel = minLevel;
        this.maxLevel = maxLevel;
        this.level = 0.0f;
        this.isActive = false;
        this.logger = logger;  // ✅ INYECTADO
    }

    public float getLevel() {
        return level;
    }

    public void setLevel(float level) {
        this.level = level;
    }

    public float getMinLevel() {
        return minLevel;
    }

    public float getMaxLevel() {
        return maxLevel;
    }

    public boolean isActive() {
        return isActive;
    }

    public void setActive(boolean active) {
        isActive = active;
    }

    /**
     * Método abstracto: todo hijo DEBE implementar.
     * ✅ ABSTRACT: Viola LSP si no se implementa correctamente.
     * Define claramente qué es un gestor de sensores.
     */
    public abstract void run();
}
```

