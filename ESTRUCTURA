package domain.service;

/**
 * Contrato para estrategias de control automático de bomba.
 * Permite diferentes algoritmos de decisión sin modificar WaterLevelManager.
 */
public interface PumpStrategy {
    /**
     * Determina si la bomba debe encenderse.
     * @param currentPercentage Porcentaje actual del tanque
     * @param isPumpActive Estado actual de la bomba
     * @return true si la bomba debe encenderse
     */
    boolean shouldTurnOn(float currentPercentage, boolean isPumpActive);

    /**
     * Determina si la bomba debe apagarse.
     * @param currentPercentage Porcentaje actual del tanque
     * @param isPumpActive Estado actual de la bomba
     * @return true si la bomba debe apagarse
     */
    boolean shouldTurnOff(float currentPercentage, boolean isPumpActive);

    /**
     * Obtiene el nombre de la estrategia.
     * @return Nombre descriptivo
     */
    String getName();
}
```

