package infrastructure.infrastructure.hardware;

import com.fazecast.jSerialComm.SerialPort;
import java.util.Scanner;
import java.util.function.Consumer;

/**
 * Comunicación serial con Arduino.
 * ✅ DESACOPLADO: Recibe Consumer<Float> en lugar de sensor específico.
 * Esto permite:
 * - Conectar a cualquier tipo de sensor
 * - Testing fácil con mocks
 * - Reutilización en diferentes contextos
 */
public class ArduinoSerial {
    private SerialPort puertoArduino;
    private Consumer<Float> onDataReceived;  // ✅ GENÉRICO - Acepta cualquier acción

    /**
     * Constructor que recibe callback genérico.
     * @param nombrePuerto Puerto COM (ej. "COM3")
     * @param onDataReceived Callback que se ejecuta cuando se reciben datos
     */
    public ArduinoSerial(String nombrePuerto, Consumer<Float> onDataReceived) {
        this.onDataReceived = onDataReceived;
        this.puertoArduino = SerialPort.getCommPort(nombrePuerto);
        this.puertoArduino.setBaudRate(9600);
        this.puertoArduino.setComPortTimeouts(SerialPort.TIMEOUT_SCANNER, 0, 0);
    }

    public void iniciarConexion() {
        if (puertoArduino.openPort()) {
            System.out.println("🔌 CONEXIÓN SERIAL: Arduino conectado exitosamente.");

            try {
                System.out.println("⏳ Esperando a que el Arduino despierte...");
                Thread.sleep(2000);
            } catch (InterruptedException e) {
                // Ignorar
            }
        } else {
            System.out.println("❌ ERROR: No se pudo abrir el puerto del Arduino.");
            return;
        }

        Thread hiloEscucha = new Thread(() -> {
            Scanner scanner = new Scanner(puertoArduino.getInputStream());

            while (scanner.hasNextLine()) {
                String lineaRecibida = scanner.nextLine().trim();

                if (lineaRecibida.isEmpty()) continue;

                try {
                    float distanciaLeida = Float.parseFloat(lineaRecibida);
                    // ✅ DESACOPLADO: Ejecuta el callback sin conocer detalles
                    onDataReceived.accept(distanciaLeida);

                } catch (NumberFormatException e) {
                    System.err.println("⚠️ Error convirtiendo a número. Basura recibida: [" + lineaRecibida + "]");
                }
            }
            scanner.close();
        });

        hiloEscucha.start();
    }

    public void cerrarConexion() {
        if (puertoArduino.isOpen()) {
            puertoArduino.closePort();
            System.out.println("Conexión serial cerrada.");
        }
    }

    public void enviarComando(String comando) {
        if (puertoArduino != null && puertoArduino.isOpen()) {
            byte[] bytes = comando.getBytes();
            puertoArduino.writeBytes(bytes, bytes.length);
        }
    }
}
