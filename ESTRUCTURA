package application.service;

import domain.service.PumpStrategy;

/**
 * Estrategia conservadora: umbrales 10% (encender) y 90% (apagar).
 * Minimiza activaciones, ideal para ahorrar energía.
 */
public class ConservativePumpStrategy implements PumpStrategy {
    private static final float TURN_ON_THRESHOLD = 10.0f;
    private static final float TURN_OFF_THRESHOLD = 90.0f;

    @Override
    public boolean shouldTurnOn(float currentPercentage, boolean isPumpActive) {
        return currentPercentage <= TURN_ON_THRESHOLD && !isPumpActive;
    }

    @Override
    public boolean shouldTurnOff(float currentPercentage, boolean isPumpActive) {
        return currentPercentage >= TURN_OFF_THRESHOLD && isPumpActive;
    }

    @Override
    public String getName() {
        return "Conservative (10%-90%)";
    }
}
```

