**Código después - Paso 4: WaterLevelManager refactorizado en application/service/**

```java
package application.service;

import domain.event.Event;
import domain.event.EventListener;
import domain.model.WaterLevelSensor;
import domain.model.WaterTank;
import domain.service.IPump;
import domain.service.IWaterSystemStatus;
import domain.service.PumpStrategy;
import domain.service.RepositoryLog;

/**
 * Gestor de nivel de agua con estrategia inyectable.
 * Responsabilidad única: reaccionar a eventos y aplicar estrategia de bombeo.
 */
public class WaterLevelManager extends SensorLevelManager implements EventListener, IWaterSystemStatus {
    private final IPump pump;
    private final WaterLevelSensor waterSensor;
    private final WaterTank tank;
    private final RepositoryLog logger;
    private final PumpStrategy pumpStrategy;  // ✅ INYECTADA

    public WaterLevelManager(
            IPump pump,
            WaterLevelSensor sensor,
            WaterTank tank,
            EventHandler handler,
            RepositoryLog logger,
            PumpStrategy pumpStrategy) {  // ✅ NUEVO PARÁMETRO
        super(20.0f, 80.0f);
        this.pump = pump;
        this.waterSensor = sensor;
        this.tank = tank;
        this.logger = logger;
        this.pumpStrategy = pumpStrategy;  // ✅ ASIGNACIÓN
        handler.subscribe(this);
    }

    @Override
    public void onEvent(Event event) {
        run();
    }

    @Override
    public void run() {
        if (!waterSensor.hasData()) return;
        
        float distanciaActual = waterSensor.getWaterLevel();
        float porcentaje = tank.calculatePercentage(distanciaActual);

        // ✅ USA LA ESTRATEGIA INYECTADA - Completamente desacoplado
        if (pumpStrategy.shouldTurnOn(porcentaje, pump.getStatus())) {
            pump.turnOn();
            logger.saveLog("[AUTO] Encendido por estrategia " + pumpStrategy.getName() 
                + ". Nivel: " + porcentaje + "%.");
        } else if (pumpStrategy.shouldTurnOff(porcentaje, pump.getStatus())) {
            pump.turnOff();
            logger.saveLog("[SEGURIDAD] Apagado por estrategia " + pumpStrategy.getName() 
                + ". Nivel: " + porcentaje + "%.");
        }
    }

    // ...resto de métodos (IWaterSystemStatus) igual...
}
```

