package domain.model;

import domain.event.Event;
import domain.event.EventListener;
import domain.event.SensorTypeEvent;
import domain.service.IAlarm;

/**
 * Alarma que reacciona a eventos críticos del sistema.
 * Implementa both EventListener (patrón Observer) e IAlarm (contrato de dominio).
 */
public class Alarm implements EventListener, IAlarm {
    private boolean isActive;
    private int volume;
    private static final float CRITICAL_LOW_PERCENTAGE = 5.0f;
    private static final float CRITICAL_HIGH_PERCENTAGE = 95.0f;

    public Alarm() {
        this.isActive = false;
        this.volume = 50;  // Volumen por defecto
    }

    @Override
    public void onEvent(Event event) {
        // ✅ Reacciona a eventos de nivel de agua
        if (event.getType() == SensorTypeEvent.WaterLevelEvent) {
            String detail = event.getDetail();
            
            // Parsea "WaterLevel: XX.XX" para obtener el porcentaje
            float percentage = extractPercentageFromDetail(detail);
            
            // Activa alarma si es crítico
            if (percentage < CRITICAL_LOW_PERCENTAGE || percentage > CRITICAL_HIGH_PERCENTAGE) {
                this.turnOn();
                System.err.println("🚨 ALARMA CRÍTICA! Nivel: " + percentage + "%");
            } else {
                this.turnOff();
            }
        }
    }

    private float extractPercentageFromDetail(String detail) {
        // Detail es "WaterLevel: XX.XX"
        try {
            String[] parts = detail.split(": ");
            return Float.parseFloat(parts[1]);
        } catch (Exception e) {
            return 50.0f;  // Default si hay error
        }
    }

    @Override
    public void turnOn() {
        isActive = true;
    }

    @Override
    public void turnOff() {
        isActive = false;
    }

    @Override
    public boolean isActive() {
        return isActive;
    }

    @Override
    public void setVolume(int volume) {
        this.volume = Math.max(0, Math.min(100, volume));
    }

    @Override
    public int getVolume() {
        return volume;
    }
}
